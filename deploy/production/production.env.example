RECYCLEROS_API_IMAGE=ghcr.io/effortless-smoke/recycleros-api
RECYCLEROS_API_IMAGE_DIGEST=sha256:replace_with_approved_64_character_digest
RECYCLEROS_RELEASE_SHA=replace_with_40_character_git_sha
RECYCLEROS_TRUSTED_HOSTS=api.example.invalid
RECYCLEROS_CORS_ORIGINS=https://app.example.invalid
RECYCLEROS_FORWARDED_ALLOW_IPS=127.0.0.1
RECYCLEROS_API_PORT=8000
RECYCLEROS_API_WORKERS=2
RECYCLEROS_API_MEMORY_LIMIT=1g
RECYCLEROS_API_CPU_LIMIT=1.0
RECYCLEROS_SESSION_TTL_HOURS=8
RECYCLEROS_AUTH_MAX_FAILURES=5
RECYCLEROS_AUTH_LOCKOUT_MINUTES=15

# Required only for the first-owner bootstrap profile.
RECYCLEROS_BOOTSTRAP_OWNER_EMAIL=owner@example.invalid
RECYCLEROS_BOOTSTRAP_OWNER_DISPLAY_NAME=Production Owner
RECYCLEROS_BOOTSTRAP_ORGANIZATION_ID=org-production
RECYCLEROS_BOOTSTRAP_ORGANIZATION_NAME=Effortless Smoke, LLC
RECYCLEROS_BOOTSTRAP_WORKSPACE_ID=workspace-production
RECYCLEROS_BOOTSTRAP_WORKSPACE_NAME=RecyclerOS Production
